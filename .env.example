APP_ENV=development
LOG_LEVEL=INFO
RUN_MIGRATIONS=false
BOOTSTRAP_ADMIN=false
SEED_DEMO_DATA=false
AGENT_RATE_LIMIT_REQUESTS=10
AGENT_RATE_LIMIT_WINDOW_SECONDS=60
AGENT_APPROVAL_EXPIRE_MINUTES=15
LANGGRAPH_STRICT_MSGPACK=true
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_SECURE=false
DATABASE_URL=postgresql+psycopg://loyalty:loyalty@db:5432/loyalty
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
EVALUATION_JUDGE_MODEL=gpt-5.6-sol
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=loyalty-analytics-agent
ANALYTICS_PROVIDER=postgresql
SNOWFLAKE_FALLBACK_TO_POSTGRESQL=true
SNOWFLAKE_SYNC_ON_START=false
SNOWFLAKE_SYNC_TOKEN=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_WAREHOUSE=LOYALTY_ANALYTICS_WH
SNOWFLAKE_DATABASE=LOYALTY_ANALYTICS
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_ROLE=LOYALTY_ANALYTICS_APP
